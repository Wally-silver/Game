{
  "name": "Battle",
  "description": "Mount BattleSceneController + BattleHUD + RuleSelectPopup. Controller drives battle lifecycle, HUD handles view/input only.",
  "ui": {
    "topBar": ["timer", "order", "joy", "gold", "rule", "goal"],
    "buildingList": "dynamic BuildingActionItem list via buildingListRoot + buildingItemTemplate",
    "rulePopup": "dynamic RuleOptionItem list via optionListRoot + optionTemplate",
    "eventFeed": "battle event log"
  }
}
